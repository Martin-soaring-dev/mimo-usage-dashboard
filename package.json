{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mimo-usage-dashboard",
  "version": "0.2.0",
  "description": "MiMo Desktop local usage dashboard — a zero-AI Python CLI that renders static HTML (token usage, cache hit rate, model share, session stats, context occupancy). No server, no ports, no network.",
  "type": "module",
  "license": "MIT",
  "author": "Martin-soaring-dev",
  "files": [
    "usage_cli.py",
    "register_command.py",
    "install.ps1",
    "usage.cmd",
    "skill",
    "docs",
    "test",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "mimo",
    "mimo-desktop",
    "mimocode",
    "xiaomi",
    "opencode",
    "usage",
    "dashboard",
    "tokens",
    "cache",
    "heatmap",
    "python",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-soaring-dev/mimo-usage-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Martin-soaring-dev/mimo-usage-dashboard/issues"
  },
  "homepage": "https://github.com/Martin-soaring-dev/mimo-usage-dashboard#readme",
  "scripts": {
    "usage": "python usage_cli.py --open",
    "usage:all": "python usage_cli.py all",
    "usage:token": "python usage_cli.py token",
    "usage:session": "python usage_cli.py session",
    "usage:context": "python usage_cli.py context",
    "register": "python register_command.py",
    "unregister": "python register_command.py --uninstall",
    "test": "python test/test_python.py && node test/runtime-check.mjs && node test/command-e2e.mjs && node test/ui-dom.mjs",
    "test:node": "node test/command-e2e.mjs",
    "test:runtime": "node test/runtime-check.mjs",
    "test:ui-dom": "node test/ui-dom.mjs",
    "test:geometry": "node test/ui-geometry.mjs",
    "test:live": "python test/e2e_live.py",
    "test:all": "python test/test_python.py && node test/runtime-check.mjs && node test/command-e2e.mjs && node test/ui-dom.mjs && node test/ui-geometry.mjs && python test/e2e_live.py"
  },
  "engines": {
    "python": ">=3.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
